  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "db:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "auth:migrate": "npx --yes auth@latest migrate --config ./src/auth/auth.ts",
    "auth:generate": "npx --yes auth@latest generate --config ./src/auth/auth.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.3",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.25",
    "dotenv": "^17.2.3",
    "fast-glob": "^3.3.3",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^3.0.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "typeorm": "^0.3.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
